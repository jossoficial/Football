# ============================================
# CONFIGURACIÓN DE RAILWAY
# ============================================

# Puerto en el que se ejecuta la aplicación
PORT=5000

# Ambiente de ejecución (development, staging, production)
ENVIRONMENT=production

# ============================================
# BASE DE DATOS
# ============================================

# PostgreSQL (Railway proporciona DATABASE_URL automáticamente)
DATABASE_URL=postgresql://user:password@localhost:5432/football_db

# ============================================
# APIS EXTERNAS
# ============================================

# API de obtención de datos deportivos (ej: API-FOOTBALL)
SPORTS_API_KEY=your_api_key_here
SPORTS_API_BASE_URL=https://api-football-v3.p.rapidapi.com

# ============================================
# CONFIGURACIÓN DE APUESTAS
# ============================================

# Margen mínimo de value (en decimal, ej: 0.05 = 5%)
VALUE_MARGIN_THRESHOLD=0.03

# ROI mínimo aceptable para un pick (%)
MIN_ROI_THRESHOLD=5.0

# ============================================
# NOTIFICACIONES
# ============================================

# Webhook para enviar picks (ej: Discord, Telegram, Slack)
WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Email para reportes diarios
ALERT_EMAIL=your-email@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your_app_password

# ============================================
# LOGGING
# ============================================

# Nivel de logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
